# 9amLeads Production Configuration
# Copy this to .env and fill in your keys

# Domain
DOMAIN=www.9amleads.com
SUPPORT_EMAIL=hello@9amleads.com

# Server
API_PORT=8012
JWT_SECRET=9amleads-prod-secret-2026

# Database (SQLite by default, set DATABASE_URL for PostgreSQL)
DB_PATH=data/9amleads-prod.db
# DATABASE_URL=postgresql://user:pass@host:5432/9amleads

# Brevo (transactional email)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Companies House (company data)
# Get your free API key from https://developer.company-information.service.gov.uk/
# The basic search works without a key, but advanced search requires one
COMPANIES_HOUSE_API_KEY=

# Gov.uk API (general purpose - Companies House, Probate, etc.)
# Register at https://developer.company-information.service.gov.uk/ for a Companies House API key
# This same key format works for other gov.uk APIs
GOVUK_API_KEY=

# Apify (web scraping)
# Get your API key from https://console.apify.com
APIFY_API_KEY=apify_api_...

# Stripe (payments)
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=whsec_... # Get from Stripe Dashboard > Webhooks > Your Endpoint > Signing Secret
